#!/usr/bin/env bash
# music - a small mpv wrapper for playing a music library.
#
# Mounts the library with rclone, runs one detached audio-only mpv instance
# with an IPC socket, and forwards simple controls to it.
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/music/config"
# shellcheck disable=SC1090
if [ -f "$CONFIG_FILE" ]; then
    . "$CONFIG_FILE"
fi

MUSIC_DIR="${MUSIC_DIR:-$HOME/Music}"
MUSIC_REMOTE="${MUSIC_REMOTE:-sam:/Volumes/NASH_SYNC/music/library}"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/music-mount-${UID}"
SOCKET="$RUNTIME_DIR/mpv.sock"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/music"
RCLONE_LOG="$CACHE_DIR/rclone.log"
MPV_LOG="$CACHE_DIR/mpv.log"
RCLONE_PID="$CACHE_DIR/rclone.pid"
MPV_PID="$CACHE_DIR/mpv.pid"

MPV_ARGS=(
    --idle=yes
    --no-video
    --no-terminal
    --really-quiet
    --input-ipc-server="$SOCKET"
    --directory-mode=recursive
    --directory-filter-types=audio
    --gapless-audio=yes
    --audio-display=no
    --no-resume-playback
    --save-position-on-quit=no
    --cache=yes
    --demuxer-max-bytes=128MiB
    --demuxer-readahead-secs=20
)

die() {
    printf 'music: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: music [command] [arguments]

With no command, mount the music library (same as "music mount").

Library
  mount                    Mount the music library (foreground; Ctrl-C unmounts)
  unmount                  Stop playback, then unmount the library
  status                   Show mount, mpv, and now-playing state

Playback
  play [PATH] [--shuffle]  Replace the queue with PATH (album/artist/track).
                           With no PATH, play the whole library shuffled.
  add PATH...              Append albums/artists/tracks to the queue
  browse                   Pick artists and albums with fzf
  toggle                   Toggle pause
  pause | resume
  next | prev              Previous/next entry in the queue
  stop                     Stop playback, keep mpv running
  volume N|+N|-N           Set or adjust volume
  seek N|-N|N%             Seek absolute seconds, relative seconds, or percent
  shuffle [on|off|toggle]  Shuffle the queue
  repeat [off|all|one]     Repeat mode
  quit                     Stop and exit the mpv daemon
  controls                 Single-key control panel (q detaches, Q quits mpv)
  logs [-f]                Show rclone/mpv logs

Environment / config
  MUSIC_DIR        Music mountpoint        (default: ~/Music)
  MUSIC_REMOTE     rclone remote:path     (default: sam:/Volumes/NASH_SYNC/music/library)
  Config file      ~/.config/music/config (sourced by the script)
  Runtime socket   ${XDG_RUNTIME_DIR}/music-mount-$UID/mpv.sock
EOF
}

# ---------------------------------------------------------------- IPC helpers

# ipc COMMAND [ARGS...]
# Send one mpv command over the IPC socket. Prints the reply's "data" as JSON.
ipc() {
    python3 - "$SOCKET" "$@" <<'PY'
import json
import re
import socket
import sys

sock_path = sys.argv[1]
args = sys.argv[2:]

command = []
for arg in args:
    if arg == "true":
        command.append(True)
    elif arg == "false":
        command.append(False)
    elif re.fullmatch(r"-?\d+", arg):
        command.append(int(arg))
    elif re.fullmatch(r"-?\d+\.\d+", arg):
        command.append(float(arg))
    else:
        command.append(arg)

request = {"command": command, "request_id": 1}
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.settimeout(3)
try:
    sock.connect(sock_path)
except OSError:
    print("music: mpv is not running", file=sys.stderr)
    sys.exit(3)

sock.sendall((json.dumps(request) + "\n").encode())
buf = b""
while True:
    try:
        chunk = sock.recv(65536)
    except socket.timeout:
        break
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        try:
            reply = json.loads(line)
        except json.JSONDecodeError:
            continue
        if reply.get("request_id") != 1:
            continue
        error = reply.get("error")
        if error and error != "success":
            print(f"music: mpv error: {error}", file=sys.stderr)
            sys.exit(1)
        if "data" in reply:
            print(json.dumps(reply["data"]))
        sys.exit(0)
PY
}

# Emit a JSON object with the player properties used by "status".
mpv_status_json() {
    python3 - "$SOCKET" <<'PY'
import json
import socket
import sys

sock_path = sys.argv[1]
props = [
    "idle-active", "media-title", "metadata", "path", "time-pos", "duration",
    "pause", "volume", "shuffle", "loop-playlist", "loop-file",
    "playlist-pos", "playlist-count",
]

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.settimeout(3)
try:
    sock.connect(sock_path)
except OSError:
    sys.exit(3)

for i, prop in enumerate(props, 1):
    request = {"command": ["get_property", prop], "request_id": i}
    sock.sendall((json.dumps(request) + "\n").encode())

out = {}
pending = set(range(1, len(props) + 1))
buf = b""
while pending:
    try:
        chunk = sock.recv(65536)
    except socket.timeout:
        break
    if not chunk:
        break
    buf += chunk
    while b"\n" in buf:
        line, buf = buf.split(b"\n", 1)
        try:
            reply = json.loads(line)
        except json.JSONDecodeError:
            continue
        rid = reply.get("request_id")
        if rid not in pending:
            continue
        pending.discard(rid)
        out[props[rid - 1]] = reply.get("data") if reply.get("error") == "success" else None

print(json.dumps(out))
PY
}

mpv_alive() {
    [ -S "$SOCKET" ] || return 1
    ipc get_property idle-active >/dev/null 2>&1
}

ensure_daemon() {
    command -v mpv >/dev/null 2>&1 || die "mpv not found"
    command -v python3 >/dev/null 2>&1 || die "python3 not found"

    mpv_alive && return 0

    mkdir -p "$RUNTIME_DIR" "$CACHE_DIR"
    rm -f "$SOCKET"

    # Clean up a wedged instance that still owns our socket path.
    pkill -f -- "input-ipc-server=$SOCKET" >/dev/null 2>&1 || true

    nohup mpv "${MPV_ARGS[@]}" >"$MPV_LOG" 2>&1 &
    echo $! >"$MPV_PID"

    local i
    for i in {1..50}; do
        [ -S "$SOCKET" ] && mpv_alive && return 0
        sleep 0.1
    done
    die "mpv failed to start (see $MPV_LOG)"
}

# ------------------------------------------------------------------- mounting

is_mounted() {
    mountpoint -q "$MUSIC_DIR" 2>/dev/null
}

do_mount() {
    command -v rclone >/dev/null 2>&1 || die "rclone not found"
    if is_mounted; then
        printf 'already mounted at %s\n' "$MUSIC_DIR"
        return 0
    fi
    mkdir -p "$MUSIC_DIR"
    exec rclone mount "$MUSIC_REMOTE" "$MUSIC_DIR" --read-only --dir-cache-time=10m
}

ensure_mount() {
    is_mounted && return 0
    command -v rclone >/dev/null 2>&1 || die "rclone not found"
    mkdir -p "$MUSIC_DIR" "$CACHE_DIR"

    if [ -f "$RCLONE_PID" ] && kill -0 "$(cat "$RCLONE_PID")" 2>/dev/null; then
        :
    else
        nohup rclone mount "$MUSIC_REMOTE" "$MUSIC_DIR" \
            --read-only --dir-cache-time=10m >>"$RCLONE_LOG" 2>&1 &
        echo $! >"$RCLONE_PID"
    fi

    local i
    for i in {1..75}; do
        is_mounted && return 0
        sleep 0.2
    done
    die "failed to mount $MUSIC_DIR (see $RCLONE_LOG)"
}

do_unmount() {
    if [ -S "$SOCKET" ] && mpv_alive; then
        ipc stop >/dev/null 2>&1 || true
        sleep 0.3
    fi

    if is_mounted; then
        command -v fusermount3 >/dev/null 2>&1 || die "fusermount3 not found"
        if ! fusermount3 -u "$MUSIC_DIR" 2>/dev/null; then
            printf 'music: normal unmount failed, trying lazy unmount\n' >&2
            fusermount3 -uz "$MUSIC_DIR" || die "failed to unmount $MUSIC_DIR"
        fi
        printf 'unmounted %s\n' "$MUSIC_DIR"
    else
        printf 'not mounted: %s\n' "$MUSIC_DIR"
    fi

    rm -f "$RCLONE_PID"
}

# ------------------------------------------------------------------ utilities

fmt_time() {
    local t="${1:-}"
    case "$t" in
        ""|null) printf '%s' "--:--"; return ;;
    esac
    t="${t%%.*}"
    if (( t >= 3600 )); then
        printf '%d:%02d:%02d' $((t / 3600)) $(((t % 3600) / 60)) $((t % 60))
    else
        printf '%d:%02d' $((t / 60)) $((t % 60))
    fi
}

resolve_path() {
    local p="$1" match

    if [ -e "$p" ]; then
        readlink -f -- "$p"
        return 0
    fi
    if [ -e "$MUSIC_DIR/$p" ]; then
        readlink -f -- "$MUSIC_DIR/$p"
        return 0
    fi

    match=$(find "$MUSIC_DIR" -maxdepth 4 -ipath "$MUSIC_DIR/$p" -print -quit 2>/dev/null || true)
    if [ -n "$match" ]; then
        printf '%s\n' "$match"
        return 0
    fi

    die "no such path: $p (looked in $MUSIC_DIR)"
}

# -------------------------------------------------------------------- status

cmd_status() {
    command -v jq >/dev/null 2>&1 || die "jq not found"
    command -v python3 >/dev/null 2>&1 || die "python3 not found"

    if is_mounted; then
        printf 'library: mounted at %s\n' "$MUSIC_DIR"
    else
        printf 'library: not mounted at %s\n' "$MUSIC_DIR"
    fi

    if ! mpv_alive; then
        printf 'mpv: not running\n'
        return 0
    fi

    local st idle title artist album pos dur paused vol shuffle lp lf ppos pcount now icon repeat
    st=$(mpv_status_json) || {
        printf 'mpv: not responding\n'
        return 0
    }

    idle=$(jq -r '.["idle-active"] // false' <<<"$st")
    title=$(jq -r '.["media-title"] // ""' <<<"$st")
    artist=$(jq -r '.metadata.Artist // .metadata.artist // ""' <<<"$st")
    album=$(jq -r '.metadata.Album // .metadata.album // ""' <<<"$st")
    pos=$(jq -r '.["time-pos"] // ""' <<<"$st")
    dur=$(jq -r '.duration // ""' <<<"$st")
    paused=$(jq -r '.pause // false' <<<"$st")
    vol=$(jq -r '.["volume"] // 0 | floor' <<<"$st")
    shuffle=$(jq -r '.shuffle // false' <<<"$st")
    lp=$(jq -r '.["loop-playlist"] // "no"' <<<"$st")
    lf=$(jq -r '.["loop-file"] // "no"' <<<"$st")
    ppos=$(jq -r '.["playlist-pos"] // -1' <<<"$st")
    pcount=$(jq -r '.["playlist-count"] // 0' <<<"$st")

    if [ "$idle" = "true" ] || [ -z "$title" ]; then
        printf 'mpv: idle (queue empty)\n'
        return 0
    fi

    icon=">"
    [ "$paused" = "true" ] && icon="||"

    now="$title"
    [ -n "$artist" ] && now="$artist — $title"
    [ -n "$album" ] && now="$now [$album]"

    case "$lf" in
        inf|yes) repeat="one" ;;
        *)
            case "$lp" in
                inf|yes) repeat="all" ;;
                *) repeat="off" ;;
            esac
            ;;
    esac

    local queue=""
    if (( pcount > 0 )) && (( ppos >= 0 )); then
        queue="  ($((ppos + 1))/$pcount)"
    fi

    printf '%s %s  [%s / %s]  vol %s%%  shuffle %s  repeat %s%s\n' \
        "$icon" "$now" "$(fmt_time "$pos")" "$(fmt_time "$dur")" \
        "$vol" "$([ "$shuffle" = "true" ] && echo on || echo off)" "$repeat" "$queue"
}

# ------------------------------------------------------------------ playback

wait_playing() {
    local i st
    for i in {1..30}; do
        st=$(mpv_status_json 2>/dev/null || true)
        if [ -n "$st" ] \
            && [ "$(jq -r '.["idle-active"] // true' <<<"$st")" = "false" ] \
            && [ -n "$(jq -r '.["time-pos"] // empty' <<<"$st")" ]; then
            return 0
        fi
        sleep 0.1
    done
}

cmd_play() {
    local path="" do_shuffle=0 arg
    for arg in "$@"; do
        case "$arg" in
            --shuffle|-s) do_shuffle=1 ;;
            -h|--help) usage; return 0 ;;
            -*) die "unknown option: $arg" ;;
            *) path="$arg" ;;
        esac
    done

    ensure_mount
    ensure_daemon

    ipc set_property shuffle no >/dev/null

    if [ -z "$path" ]; then
        ipc loadfile "$MUSIC_DIR" replace >/dev/null
        ipc set_property shuffle yes >/dev/null
    else
        local resolved
        resolved=$(resolve_path "$path")
        ipc loadfile "$resolved" replace >/dev/null
        (( do_shuffle )) && ipc set_property shuffle yes >/dev/null
    fi

    ipc set_property pause no >/dev/null
    wait_playing
    cmd_status
}

# Build an m3u playlist from files/directories. Directories are scanned for
# audio files so appended queues have real entries instead of one lazy folder.
build_playlist() {
    local out="$1"
    shift
    local p f
    printf '#EXTM3U\n' >"$out"
    for p in "$@"; do
        if [ -d "$p" ]; then
            find "$p" -type f \
                \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.m4a' \
                -o -iname '*.aac' -o -iname '*.ogg' -o -iname '*.opus' \
                -o -iname '*.wav' -o -iname '*.aif' -o -iname '*.aiff' \
                -o -iname '*.alac' -o -iname '*.wma' -o -iname '*.ape' \
                -o -iname '*.wv' -o -iname '*.dsf' -o -iname '*.dff' \) \
                -print 2>/dev/null | sort >>"$out" || true
        elif [ -f "$p" ]; then
            printf '%s\n' "$p" >>"$out"
        fi
    done
}

cmd_add() {
    (( $# > 0 )) || die "usage: music add PATH..."
    ensure_mount
    ensure_daemon
    local p resolved tmp
    local -a paths=()
    for p in "$@"; do
        resolved=$(resolve_path "$p")
        paths+=("$resolved")
    done
    tmp=$(mktemp "$RUNTIME_DIR/queue-add.XXXXXX.m3u")
    build_playlist "$tmp" "${paths[@]}"
    ipc loadlist "$tmp" append >/dev/null
    rm -f "$tmp"
    ipc set_property pause no >/dev/null
    printf 'queued %d path(s)\n' "$#"
}

cmd_browse() {
    command -v fzf >/dev/null 2>&1 || die "fzf not found"
    ensure_mount

    local -a artists albums picks
    local artist choice first

    mapfile -t artists < <(
        find "$MUSIC_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
    )
    (( ${#artists[@]} > 0 )) || die "no artists found under $MUSIC_DIR"

    choice=$(
        {
            printf '%s\n' '[shuffle all]'
            printf '%s\n' "${artists[@]}"
        } | fzf --reverse --height=100% --prompt='Artist> ' \
            --header='Enter: choose · Esc: cancel'
    ) || exit 0
    [ -n "$choice" ] || exit 0

    if [ "$choice" = '[shuffle all]' ]; then
        cmd_play --shuffle
        return 0
    fi

    artist="$choice"
    mapfile -t albums < <(
        find "$MUSIC_DIR/$artist" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
    )

    if (( ${#albums[@]} == 0 )); then
        cmd_play "$artist"
        return 0
    fi

    local picked
    picked=$(
        {
            printf '%s\n' '[whole artist]'
            printf '%s\n' "${albums[@]}"
        } | fzf --reverse --height=100% --multi --prompt="$artist > " \
            --header='Tab: multi-select · Enter: play · Esc: cancel'
    ) || exit 0
    [ -n "$picked" ] || exit 0

    mapfile -t picks <<<"$picked"

    ensure_daemon
    ipc set_property shuffle no >/dev/null

    local -a paths=()
    for choice in "${picks[@]}"; do
        if [ "$choice" = '[whole artist]' ]; then
            paths+=("$MUSIC_DIR/$artist")
        else
            paths+=("$MUSIC_DIR/$artist/$choice")
        fi
    done

    first=$(mktemp "$RUNTIME_DIR/queue-browse.XXXXXX.m3u")
    build_playlist "$first" "${paths[@]}"
    ipc loadlist "$first" replace >/dev/null
    rm -f "$first"

    ipc set_property pause no >/dev/null
    wait_playing
    cmd_status
}

cmd_toggle() {
    mpv_alive || die "mpv is not running"
    ipc cycle pause >/dev/null
}

cmd_pause() {
    mpv_alive || die "mpv is not running"
    ipc set_property pause true >/dev/null
}

cmd_resume() {
    mpv_alive || die "mpv is not running"
    ipc set_property pause false >/dev/null
}

cmd_next() {
    mpv_alive || die "mpv is not running"
    if ! ipc playlist-next >/dev/null 2>&1; then
        # At the end of the queue: wrap to the first entry.
        ipc playlist-play-index 0 >/dev/null 2>&1 || true
    fi
}

cmd_prev() {
    mpv_alive || die "mpv is not running"
    if ! ipc playlist-prev >/dev/null 2>&1; then
        local count
        count=$(ipc get_property playlist-count 2>/dev/null || echo 0)
        if (( count > 0 )); then
            ipc playlist-play-index "$((count - 1))" >/dev/null 2>&1 || true
        fi
    fi
}

cmd_stop() {
    mpv_alive || die "mpv is not running"
    ipc stop >/dev/null
}

cmd_volume() {
    [ $# -ge 1 ] || die "usage: music volume N|+N|-N"
    local v="$1"
    case "$v" in
        +*) ipc add volume "${v#+}" >/dev/null ;;
        -*) ipc add volume "$v" >/dev/null ;;
        *) ipc set_property volume "$v" >/dev/null ;;
    esac
}

cmd_seek() {
    [ $# -ge 1 ] || die "usage: music seek N|-N|N%"
    local v="$1"
    case "$v" in
        *%) ipc seek "${v%\%}" absolute-percent >/dev/null ;;
        +*) ipc seek "${v#+}" relative >/dev/null ;;
        -*) ipc seek "$v" relative >/dev/null ;;
        *) ipc seek "$v" absolute >/dev/null ;;
    esac
}

cmd_shuffle() {
    local mode="${1:-toggle}"
    case "$mode" in
        on|yes|true) ipc set_property shuffle true >/dev/null ;;
        off|no|false) ipc set_property shuffle false >/dev/null ;;
        toggle) ipc cycle shuffle >/dev/null ;;
        *) die "usage: music shuffle [on|off|toggle]" ;;
    esac
}

cmd_repeat() {
    case "${1:-}" in
        off|no)
            ipc set_property loop-playlist no >/dev/null
            ipc set_property loop-file no >/dev/null
            ;;
        all)
            ipc set_property loop-file no >/dev/null
            ipc set_property loop-playlist yes >/dev/null
            ;;
        one)
            ipc set_property loop-playlist no >/dev/null
            ipc set_property loop-file yes >/dev/null
            ;;
        *)
            die "usage: music repeat [off|all|one]"
            ;;
    esac
}

cmd_repeat_cycle() {
    local lp lf
    lp=$(ipc get_property loop-playlist 2>/dev/null | tr -d '"' || true)
    lf=$(ipc get_property loop-file 2>/dev/null | tr -d '"' || true)
    case "$lf" in
        inf|yes) cmd_repeat off ;;
        *)
            case "$lp" in
                inf|yes) cmd_repeat one ;;
                *) cmd_repeat all ;;
            esac
            ;;
    esac
}

cmd_quit() {
    if mpv_alive; then
        ipc quit >/dev/null 2>&1 || true
        local i
        for i in {1..30}; do
            mpv_alive || break
            sleep 0.1
        done
        printf 'mpv stopped\n'
    else
        printf 'mpv is not running\n'
    fi
    rm -f "$SOCKET" "$MPV_PID"
}

cmd_logs() {
    local -a files=()
    [ -f "$RCLONE_LOG" ] && files+=("$RCLONE_LOG")
    [ -f "$MPV_LOG" ] && files+=("$MPV_LOG")
    (( ${#files[@]} > 0 )) || die "no logs yet in $CACHE_DIR"
    if [ "${1:-}" = "-f" ]; then
        exec tail -n 100 -f "${files[@]}"
    else
        tail -n 100 "${files[@]}"
    fi
}

cmd_controls() {
    [ -t 0 ] && [ -t 1 ] || die "controls needs an interactive terminal"
    mpv_alive || ensure_daemon

    local old_stty key rest cols width line1 line2 l frame prev_frame
    local help1='space pause · n/p next/prev · ←/→ seek 10s'
    local help2='↑/↓ volume 5 · s shuffle · r repeat · q detach · Q quit'
    local -a status_lines

    old_stty=$(stty -g)
    trap 'stty "$old_stty"; printf "\033[?25h\033[?1049l"' EXIT INT TERM
    stty raw -echo
    printf '\033[?1049h\033[?25l\033[H\033[2J'
    prev_frame=""

    while :; do
        cols=$(tput cols 2>/dev/null || true)
        [ -n "${cols:-}" ] || cols=${COLUMNS:-80}
        (( cols > 20 )) || cols=80
        width=$((cols - 1))

        mapfile -t status_lines < <(cmd_status)
        line1=""
        line2=""
        for l in "${status_lines[@]}"; do
            case "$l" in
                'library: mounted at '*) ;;               # hide when healthy
                'library: not mounted'*) line1="$l" ;;    # keep the warning
                *)
                    if [ -z "$line1" ]; then
                        line1="$l"
                    else
                        line2="$l"
                    fi
                    ;;
            esac
        done

        # Redraw in place, and only when the content or width changed; no
        # full-screen clears, which is what made the panel flicker.
        frame="$cols"$'\n'"$line1"$'\n'"$line2"
        if [ "$frame" != "$prev_frame" ]; then
            printf '\033[H'
            printf '%s\033[K\n' "${line1:0:width}"
            printf '\033[K\n'
            printf '%s\033[K\n' "${help1:0:width}"
            printf '%s\033[K\n' "${help2:0:width}"
            printf '\033[J'
            prev_frame="$frame"
        fi

        key=""
        IFS= read -rsn1 -t 1 key || true

        if [ "$key" = $'\e' ]; then
            rest=""
            IFS= read -rsn2 -t 0.05 rest || true
            key="$key$rest"
        fi

        case "$key" in
            "") continue ;;
            ' ') ipc cycle pause >/dev/null 2>&1 || true ;;
            n|N) cmd_next >/dev/null 2>&1 || true ;;
            p|P) cmd_prev >/dev/null 2>&1 || true ;;
            $'\e[C') ipc seek 10 relative >/dev/null 2>&1 || true ;;
            $'\e[D') ipc seek -10 relative >/dev/null 2>&1 || true ;;
            $'\e[A') ipc add volume 5 >/dev/null 2>&1 || true ;;
            $'\e[B') ipc add volume -5 >/dev/null 2>&1 || true ;;
            s|S) cmd_shuffle toggle >/dev/null 2>&1 || true ;;
            r|R) cmd_repeat_cycle >/dev/null 2>&1 || true ;;
            q) break ;;
            Q) cmd_quit >/dev/null 2>&1 || true; break ;;
        esac
        prev_frame=""
    done

    stty "$old_stty"
    printf '\033[?25h\033[?1049l'
    trap - EXIT INT TERM
}

# ------------------------------------------------------------------- dispatch

cmd="${1:-mount}"
if [ $# -gt 0 ]; then
    shift
fi

case "$cmd" in
    ""|mount) do_mount ;;
    unmount|umount) do_unmount ;;
    status|now) cmd_status ;;
    play) cmd_play "$@" ;;
    add) cmd_add "$@" ;;
    browse|pick) cmd_browse ;;
    toggle) cmd_toggle ;;
    pause) cmd_pause ;;
    resume) cmd_resume ;;
    next) cmd_next ;;
    prev) cmd_prev ;;
    stop) cmd_stop ;;
    volume) cmd_volume "$@" ;;
    seek) cmd_seek "$@" ;;
    shuffle) cmd_shuffle "${1:-toggle}" ;;
    repeat) cmd_repeat "${1:-}" ;;
    quit) cmd_quit ;;
    controls|ui) cmd_controls ;;
    logs) cmd_logs "${1:-}" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $cmd (try: music help)" ;;
esac
